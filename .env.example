# The keys of the wslib-rs 1Password Environment, mounted at .env.
# .env is not committed.

# The publish token (write:package), without "Bearer ", which release.sh adds.
WSLIB_REGISTRY_TOKEN=<token>

# The Forgejo instance and owner the registry lives under.
WSLIB_FORGE_URL=https://forge.example.com
WSLIB_FORGE_OWNER=<owner>

# The mirror's docroot as an rsync destination, ending in : or /
# (user@host: when the key is restricted to rrsync, else user@host:/docroot/).
WSLIB_MIRROR_DEST=<user>@<host>:
